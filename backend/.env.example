# Доступы от Green-API (из личного кабинета)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Номер телефона для тестовой отправки (кому пишем)
# Формат: код страны + номер + @c.us
TEST_PHONE_NUMBER=79991234567@c.us

# Номер оператора — сюда уходят уведомления об эскалации диалога
OPERATOR_CHAT_ID=

# Настройки локального сервера
PORT=5000

# Cerebras (LLM)
CEREBRAS_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://opti_bot:opti_bot@localhost:5432/opti_bot

# Redis
REDIS_URL=redis://localhost:6379/0
